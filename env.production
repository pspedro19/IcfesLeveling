# ============================================
# ICFES LEVELING - PRODUCTION ENVIRONMENT
# ============================================

# Application
NODE_ENV=production
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_APP_NAME="ICFES Leveling"
NEXT_PUBLIC_APP_VERSION="2.0.0"
DEBUG=false

# API Configuration
NEXT_PUBLIC_API_URL=https://api.icfesleveling.com
NEXT_PUBLIC_API_TIMEOUT=15000
API_SECRET_KEY=your-secret-key-here-change-in-production

# WebSocket Configuration
NEXT_PUBLIC_WS_URL=wss://ws.icfesleveling.com
NEXT_PUBLIC_WS_RECONNECT_ATTEMPTS=5
NEXT_PUBLIC_WS_RECONNECT_DELAY=3000

# Database
DATABASE_URL=postgresql://gameplay:gameplay123@postgres:5432/icfes_leveling
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=your-redis-password-here
REDIS_CACHE_TTL=3600

# Media/CDN
NEXT_PUBLIC_MEDIA_URL=https://cdn.icfesleveling.com/media
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
CDN_SECRET_KEY=your-cdn-secret-here

# Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
NEXT_PUBLIC_TOKEN_EXPIRY=3600

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.7

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key-here
YOUTUBE_CHANNEL_IDS=UC_channel_001,UC_channel_002

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_your-stripe-public-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Analytics & Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=icfes-leveling
SENTRY_PROJECT=production
SENTRY_ENVIRONMENT=production

# ClickHouse Analytics
CLICKHOUSE_URL=https://clickhouse.icfesleveling.com
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=icfes_analytics

# Google Analytics
NEXT_PUBLIC_GA_ID=G-YOUR-GA-ID

# Email Service
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@icfesleveling.com
EMAIL_REPLY_TO=support@icfesleveling.com

# Feature Flags
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_WEBSOCKET=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_MAINTENANCE=false

# Security
CORS_ORIGINS=https://icfesleveling.com,https://www.icfesleveling.com
ALLOWED_HOSTS=icfesleveling.com,www.icfesleveling.com,api.icfesleveling.com
SECRET_KEY=your-django-secret-key-change-this
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_STRATEGY=sliding-window

# Cache Configuration
NEXT_PUBLIC_CACHE_TTL=3600000
NEXT_PUBLIC_CACHE_MAX_SIZE=50
NEXT_PUBLIC_CACHE_STRATEGY=memory

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=icfes-leveling-backups
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE=/var/log/icfes-leveling/app.log
LOG_MAX_SIZE=100M
LOG_MAX_BACKUPS=10

# Performance
WORKERS=4
THREADS=2
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
TIMEOUT=30

# Monitoring Endpoints
HEALTH_CHECK_PATH=/health
METRICS_PATH=/metrics
READY_CHECK_PATH=/ready

# External Services URLs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123

# Development/Debug (set to false in production)
NEXT_PUBLIC_DEBUG=false
SHOW_SQL_QUERIES=false
PROFILING_ENABLED=false

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="El sistema está en mantenimiento. Volveremos pronto."
MAINTENANCE_END_TIME="2025-01-01T00:00:00Z"
# Production Environment Configuration
# ICFES Leveling Platform
# WARNING: This file contains sensitive information. Do not commit to version control.

# Environment
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false

# Database Configuration
DATABASE_URL=postgresql://gameplay:${POSTGRES_PASSWORD}@postgres:5432/gameplay_db
POSTGRES_DB=gameplay_db
POSTGRES_USER=gameplay
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# ClickHouse Configuration (Analytics)
CLICKHOUSE_URL=clickhouse://default:${CLICKHOUSE_PASSWORD}@clickhouse:9000/gameplay_analytics
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=gameplay_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=${CLICKHOUSE_PASSWORD}

# JWT Security
JWT_SECRET=${JWT_SECRET}
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# API Keys
OPENAI_API_KEY=${OPENAI_API_KEY}
YOUTUBE_API_KEY=${YOUTUBE_API_KEY}

# CORS Configuration
ALLOWED_ORIGINS=https://localhost:4001,https://icfes-leveling.com,https://www.icfes-leveling.com
ALLOWED_HOSTS=localhost,icfes-leveling.com,www.icfes-leveling.com

# SSL Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Performance Configuration
WORKERS=4
MAX_CONNECTIONS=1000
TIMEOUT=30
KEEPALIVE=2

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CACHING=true
ENABLE_AI_FEATURES=true
ENABLE_WEBSOCKET=true
ENABLE_PREMIUM=true
ENABLE_MONITORING=true

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
ENABLE_REDIS_CACHE=true

# File Upload Configuration
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=png,jpg,jpeg,gif,webp,pdf
UPLOAD_PATH=/app/uploads

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900
ENABLE_RATE_LIMITING=true

# Security Configuration
ENABLE_HTTPS_REDIRECT=true
ENABLE_HSTS=true
ENABLE_CSP=true
ENABLE_XSS_PROTECTION=true
ENABLE_FRAME_OPTIONS=true

# Monitoring Configuration
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=8000
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://localhost:4000
NEXT_PUBLIC_WS_URL=wss://localhost:8003
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PWA=true

# Docker Configuration
COMPOSE_PROJECT_NAME=icfes-leveling-prod
DOCKER_RESTART_POLICY=unless-stopped

# Resource Limits
MEMORY_LIMIT_BACKEND=1G
MEMORY_LIMIT_FRONTEND=512M
MEMORY_LIMIT_DB=2G
MEMORY_LIMIT_REDIS=256M
MEMORY_LIMIT_CLICKHOUSE=1G

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s

# Secrets (These should be set via environment variables or secret management)
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# CLICKHOUSE_PASSWORD=
# JWT_SECRET=
# OPENAI_API_KEY=
# YOUTUBE_API_KEY=
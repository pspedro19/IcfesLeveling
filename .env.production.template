# ICFES Leveling Production Environment Variables Template
# Copy this file to .env.production and fill with secure values
# DO NOT commit .env.production to version control!

# ====================
# GENERAL CONFIGURATION
# ====================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# ====================
# SECURITY SECRETS - GENERATE STRONG VALUES!
# ====================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_MIN_32_CHARS
SECRET_KEY=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ====================
# DATABASE CONFIGURATION
# ====================
# Generate password with: openssl rand -base64 24
DB_HOST=postgres
DB_NAME=gameplay_db
DB_USER=gameplay
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MIN_16_CHARS
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ====================
# REDIS CONFIGURATION
# ====================
# Generate password with: openssl rand -base64 24
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MIN_16_CHARS
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ====================
# CLICKHOUSE CONFIGURATION
# ====================
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MIN_16_CHARS
CLICKHOUSE_DB=gameplay_analytics

# ====================
# API CONFIGURATION
# ====================
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ====================
# FRONTEND CONFIGURATION
# ====================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://ws.yourdomain.com
NEXT_PUBLIC_ENVIRONMENT=production

# ====================
# EMAIL CONFIGURATION (Optional)
# ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME="ICFES Leveling"

# ====================
# EXTERNAL SERVICES (Optional)
# ====================
# OpenAI API Key (if using AI features)
OPENAI_API_KEY=sk-your-actual-openai-api-key-here

# AWS S3 or Spaces (for file storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# ====================
# SECURITY SETTINGS
# ====================
# Rate limiting
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Session settings
SESSION_LIFETIME_SECONDS=3600
REFRESH_TOKEN_LIFETIME_DAYS=7

# Security headers
FORCE_HTTPS=true
SECURE_COOKIES=true
SAME_SITE_COOKIES=strict

# ====================
# MONITORING (Optional)
# ====================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
PROMETHEUS_ENABLED=true
GRAFANA_API_KEY=your-grafana-api-key

# ====================
# FEATURE FLAGS
# ====================
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=false
ENABLE_AI_FEATURES=true
ENABLE_GAMIFICATION=true

# ====================
# DEPLOYMENT
# ====================
DEPLOYMENT_ENV=production
SERVER_NAME=icfes-leveling-prod
SERVER_HOST=0.0.0.0
SERVER_PORT=4000
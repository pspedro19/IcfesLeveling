# =====================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - ICFES LEVELING
# =====================================================

# Entorno
ENVIRONMENT=development
DEBUG=true
NODE_ENV=development

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://gameplay:gameplay123@localhost:5432/gameplay_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gameplay_db
DB_USER=gameplay
DB_PASSWORD=gameplay123

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ClickHouse Analytics
CLICKHOUSE_URL=clickhouse://default:clickhouse123@localhost:9000/gameplay_analytics
CLICKHOUSE_DATABASE=gameplay_analytics

# JWT y Seguridad
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URLs de la Aplicación
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4002
NEXT_PUBLIC_APP_URL=http://localhost:4001
FRONTEND_URL=http://localhost:4001

# OpenAI (Opcional para funciones de IA)
OPENAI_API_KEY=

# WOMPI - Configuración de Pagos (Colombia)
# Obtén tus credenciales en https://comercios.wompi.co
WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXXX
WOMPI_EVENT_SECRET=test_events_XXXXXXXXXXXXXXXXX
# Para producción usa las credenciales de producción de Wompi

# Email (Opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Monitoreo (Opcional)
SENTRY_DSN=
LOG_LEVEL=INFO

# Almacenamiento (Opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Google Analytics (Opcional)
GA_TRACKING_ID=

# Configuración de Juego
MAX_LEVEL=100
BASE_HP=100
BASE_MP=50
BASE_POWER=10
BASE_WISDOM=10
BASE_SPEED=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Configuración de Archivos
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=[".jpg",".jpeg",".png",".gif",".pdf"]
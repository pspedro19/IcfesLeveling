<?xml version="1.0"?>
<clickhouse>
    <!-- Production Users Configuration for ClickHouse -->
    
    <profiles>
        <!-- Default profile for production -->
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
            <max_query_size>268435456</max_query_size>
            <max_ast_depth>1000</max_ast_depth>
            <max_ast_elements>50000</max_ast_elements>
            <max_expanded_ast_elements>500000</max_expanded_ast_elements>
            <readonly>0</readonly>
            <max_rows_to_read>1000000000</max_rows_to_read>
            <max_bytes_to_read>100000000000</max_bytes_to_read>
            <max_execution_time>300</max_execution_time>
            <max_columns_to_read>25</max_columns_to_read>
            <max_temporary_columns>100</max_temporary_columns>
            <max_temporary_non_const_columns>50</max_temporary_non_const_columns>
            <max_subquery_depth>100</max_subquery_depth>
            <max_pipeline_depth>1000</max_pipeline_depth>
            <max_ast_depth>1000</max_ast_depth>
            <readonly>0</readonly>
            <allow_ddl>1</allow_ddl>
            <max_sessions_for_user>100</max_sessions_for_user>
        </default>
        
        <!-- Read-only profile for reporting -->
        <readonly>
            <max_memory_usage>5000000000</max_memory_usage>
            <use_uncompressed_cache>1</use_uncompressed_cache>
            <load_balancing>nearest_hostname</load_balancing>
            <max_query_size>268435456</max_query_size>
            <readonly>1</readonly>
            <max_rows_to_read>1000000000</max_rows_to_read>
            <max_bytes_to_read>50000000000</max_bytes_to_read>
            <max_execution_time>600</max_execution_time>
            <allow_ddl>0</allow_ddl>
            <max_sessions_for_user>10</max_sessions_for_user>
        </readonly>
        
        <!-- Analytics profile for heavy queries -->
        <analytics>
            <max_memory_usage>20000000000</max_memory_usage>
            <use_uncompressed_cache>1</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
            <max_query_size>268435456</max_query_size>
            <readonly>0</readonly>
            <max_rows_to_read>10000000000</max_rows_to_read>
            <max_bytes_to_read>1000000000000</max_bytes_to_read>
            <max_execution_time>1800</max_execution_time>
            <allow_ddl>1</allow_ddl>
            <max_sessions_for_user>5</max_sessions_for_user>
        </analytics>
    </profiles>
    
    <quotas>
        <!-- Default quota -->
        <default>
            <interval>
                <duration>3600</duration>
                <queries>1000</queries>
                <errors>100</errors>
                <result_rows>1000000000</result_rows>
                <read_rows>1000000000</read_rows>
                <execution_time>3600</execution_time>
            </interval>
        </default>
        
        <!-- Analytics quota for heavy users -->
        <analytics_quota>
            <interval>
                <duration>3600</duration>
                <queries>100</queries>
                <errors>10</errors>
                <result_rows>10000000000</result_rows>
                <read_rows>10000000000</read_rows>
                <execution_time>7200</execution_time>
            </interval>
        </analytics_quota>
        
        <!-- Read-only quota -->
        <readonly_quota>
            <interval>
                <duration>3600</duration>
                <queries>500</queries>
                <errors>50</errors>
                <result_rows>100000000</result_rows>
                <read_rows>1000000000</read_rows>
                <execution_time>1800</execution_time>
            </interval>
        </readonly_quota>
    </quotas>
    
    <users>
        <!-- Default admin user -->
        <default>
            <password_sha256_hex>CHANGE_ME_SHA256_PASSWORD_HASH</password_sha256_hex>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
        
        <!-- Production analytics user -->
        <icfes_analytics>
            <password_sha256_hex>CHANGE_ME_ANALYTICS_SHA256_HASH</password_sha256_hex>
            <networks>
                <ip>172.20.0.0/16</ip>  <!-- Internal Docker network -->
                <ip>127.0.0.1</ip>      <!-- Localhost -->
            </networks>
            <profile>analytics</profile>
            <quota>analytics_quota</quota>
            <databases>
                <icfes_analytics>
                    <grants>
                        <grant>SELECT</grant>
                        <grant>INSERT</grant>
                        <grant>CREATE</grant>
                        <grant>DROP</grant>
                        <grant>ALTER</grant>
                    </grants>
                </icfes_analytics>
                <system>
                    <grants>
                        <grant>SELECT</grant>
                    </grants>
                </system>
            </databases>
        </icfes_analytics>
        
        <!-- Read-only reporting user -->
        <icfes_reporting>
            <password_sha256_hex>CHANGE_ME_REPORTING_SHA256_HASH</password_sha256_hex>
            <networks>
                <ip>172.20.0.0/16</ip>  <!-- Internal Docker network -->
                <ip>127.0.0.1</ip>      <!-- Localhost -->
            </networks>
            <profile>readonly</profile>
            <quota>readonly_quota</quota>
            <databases>
                <icfes_analytics>
                    <grants>
                        <grant>SELECT</grant>
                    </grants>
                </icfes_analytics>
                <system>
                    <grants>
                        <grant>SELECT</grant>
                    </grants>
                </system>
            </databases>
        </icfes_reporting>
        
        <!-- Application user with limited access -->
        <icfes_app>
            <password_sha256_hex>CHANGE_ME_APP_SHA256_HASH</password_sha256_hex>
            <networks>
                <ip>172.20.0.0/16</ip>  <!-- Internal Docker network only -->
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <databases>
                <icfes_analytics>
                    <grants>
                        <grant>SELECT</grant>
                        <grant>INSERT</grant>
                    </grants>
                </icfes_analytics>
            </databases>
        </icfes_app>
    </users>
</clickhouse>
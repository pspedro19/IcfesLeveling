# PRODUCTION ENVIRONMENT CONFIGURATION
# ⚠️ NEVER COMMIT THIS FILE TO VERSION CONTROL

# Environment
ENVIRONMENT=production
DEBUG=false
NODE_ENV=production

# Security - GENERATE STRONG RANDOM SECRETS FOR PRODUCTION
JWT_SECRET=CHANGE_ME_TO_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
SECRET_KEY=CHANGE_ME_TO_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database - USE STRONG PASSWORDS IN PRODUCTION
DATABASE_URL=postgresql://icfes_prod_user:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/icfes_production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=icfes_production
DB_USER=icfes_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Redis - ENABLE AUTH IN PRODUCTION
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ClickHouse
CLICKHOUSE_URL=clickhouse://icfes_analytics:CHANGE_ME_CLICKHOUSE_PASSWORD@localhost:9000/icfes_analytics
CLICKHOUSE_DATABASE=icfes_analytics
CLICKHOUSE_USER=icfes_analytics
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD

# External APIs
OPENAI_API_KEY=your_openai_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# CORS - RESTRICT TO PRODUCTION DOMAINS
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# SSL/TLS
SSL_CERT_PATH=/etc/ssl/certs/icfes.crt
SSL_KEY_PATH=/etc/ssl/private/icfes.key

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=WARNING

# Performance
MAX_WORKERS=4
REDIS_CACHE_TTL=3600
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Security Headers
SECURE_HEADERS_ENABLED=true
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# File Upload Security
MAX_FILE_SIZE=5242880  # 5MB
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp
UPLOAD_VIRUS_SCAN=true

# Backup
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_ENCRYPTION_KEY
BACKUP_S3_BUCKET=icfes-backups-prod
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
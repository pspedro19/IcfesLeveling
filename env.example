####################################################
# ICFES LEVELING - Complete Environment Variables
# Development Configuration
####################################################
#
# MANDATORY VALUES FROM PROJECT SPECIFICATION:
# - Frontend: NEXT_PUBLIC_API_URL=http://localhost:4000
# - Frontend: NEXT_PUBLIC_WS_URL=ws://localhost:4002
# - Frontend: NODE_ENV=development
# - Backend: BACKEND_PORT=4000
# - Backend: WEBSOCKET_PORT=4002
# - Backend: AI_SERVICE_PORT=8002
# - Backend: FRONTEND_PORT=4001
# - Database: POSTGRES_PORT=5433
# - Database: REDIS_PORT=6379
# - Database: CLICKHOUSE_PORT=8123
# - Auth: JWT_SECRET=your-super-secret-jwt-key-change-in-production
# - Auth: ALGORITHM=HS256
# - Auth: ACCESS_TOKEN_EXPIRE_MINUTES=30
# - Environment: ENVIRONMENT=development
# - Environment: DEBUG=true
# - API: OPENAI_API_KEY=your-key-here (replace with actual key)
#
####################################################

#==================================================
# API KEYS & EXTERNAL SERVICES
#==================================================
# OpenAI API (MANDATORY - add your own)
OPENAI_API_KEY=your-key-here

# YouTube API (for educational video recommendations)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Sentry Error Tracking (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe Payment System (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=

#==================================================
# DATABASE CONFIGURATION
#==================================================
# PostgreSQL (main database)
DATABASE_URL=postgresql://gameplay:gameplay123@localhost:5433/gameplay_db
POSTGRES_USER=gameplay
POSTGRES_PASSWORD=gameplay123
POSTGRES_DB=gameplay_db
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Redis (caching & sessions)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ClickHouse (analytics)
CLICKHOUSE_URL=clickhouse://default:clickhouse123@localhost:8123/gameplay_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse123
CLICKHOUSE_DB=gameplay_analytics
CLICKHOUSE_PORT=8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

#==================================================
# SERVICE PORTS (MANDATORY)
#==================================================
# Backend Services
BACKEND_PORT=4000
WEBSOCKET_PORT=4002
AI_SERVICE_PORT=8002
FRONTEND_PORT=4001

#==================================================
# SERVICE URLS (MANDATORY FOR FRONTEND)
#==================================================
# Frontend URLs (development)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4002
NODE_ENV=development
FRONTEND_URL=http://localhost:4001

# Backend Internal URLs
API_URL=http://localhost:4000
WS_URL=ws://localhost:4002
AI_SERVICE_URL=http://localhost:8002

#==================================================
# AUTHENTICATION & SECURITY (MANDATORY)
#==================================================
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
CORS_ORIGINS=["http://localhost:4001"]
ALLOWED_HOSTS=localhost,127.0.0.1

#==================================================
# GAME CONFIGURATION
#==================================================
# Battle Settings
MAX_QUESTIONS_PER_BATTLE=20
BATTLE_TIME_LIMIT_SECONDS=30
MIN_QUESTIONS_PER_BATTLE=5
BATTLE_PREPARATION_TIME=5

# Scoring System
CRITICAL_HIT_TIME_THRESHOLD=3
PERFECT_ANSWER_BONUS=50
STREAK_MULTIPLIER=1.5
MAX_STREAK_BONUS=5

# Experience & Progression
EXPERIENCE_MULTIPLIER=1.0
BASE_EXPERIENCE_GAIN=100
LEVEL_UP_THRESHOLD=1000
MAX_PLAYER_LEVEL=100

# Item System
ORB_DROP_RATE=0.8
RARE_ORB_DROP_RATE=0.2
LEGENDARY_ORB_DROP_RATE=0.05
MAX_INVENTORY_SIZE=100

# Matchmaking
MATCHMAKING_TIMEOUT_SECONDS=60
MMR_INITIAL_RATING=1500
MMR_K_FACTOR=32
MMR_RANGE_TOLERANCE=200

#==================================================
# AI CONFIGURATION
#==================================================
# AI Service Settings
AI_MODEL=gpt-3.5-turbo
AI_EXPLANATION_MAX_TOKENS=150
AI_TEMPERATURE=0.7
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=30

# AI Caching
AI_CACHE_ENABLED=true
AI_CACHE_TTL_DAYS=30
AI_CACHE_MAX_SIZE_MB=1000

#==================================================
# APPLICATION SETTINGS (MANDATORY)
#==================================================
# Environment
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug

# Application
APP_NAME=ICFES_LEVELING
APP_VERSION=1.0.0
APP_DESCRIPTION="Interactive ICFES Preparation Game"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

#==================================================
# MONITORING & LOGGING
#==================================================
# Logging
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/icfes-leveling
LOG_ROTATION=daily
LOG_MAX_SIZE=100M
LOG_MAX_AGE=30

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics

#==================================================
# EMAIL CONFIGURATION (optional)
#==================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@icfes-leveling.com

#==================================================
# DOCKER COMPOSE SPECIFIC
#==================================================
# Container Names
COMPOSE_PROJECT_NAME=icfes-leveling
POSTGRES_CONTAINER=icfes-postgres
REDIS_CONTAINER=icfes-redis
CLICKHOUSE_CONTAINER=icfes-clickhouse
BACKEND_CONTAINER=icfes-backend
FRONTEND_CONTAINER=icfes-frontend

# Volumes
DATA_PATH=./data
LOGS_PATH=./logs
UPLOADS_PATH=./uploads

#==================================================
# DEVELOPMENT TOOLS
#==================================================
# Hot Reload
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# Next.js Specific
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_VERCEL_URL=

# Python Specific
PYTHONUNBUFFERED=1

#==================================================
# FEATURE FLAGS
#==================================================
ENABLE_SOCIAL_LOGIN=false
ENABLE_MULTIPLAYER=true
ENABLE_TOURNAMENTS=false
ENABLE_LEADERBOARDS=true
ENABLE_ACHIEVEMENTS=true
ENABLE_DAILY_CHALLENGES=true
ENABLE_SHOP=false
ENABLE_TRADING=false

#==================================================
# BACKUP & MAINTENANCE
#==================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System under maintenance. Please try again later."
{
  "name": "icfes-leveling-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4001 -H 0.0.0.0",
    "dev:optimized": "NODE_OPTIONS='--max-old-space-size=8192 --max-semi-space-size=1024' next dev -p 4001 -H 0.0.0.0",
    "build": "npm run build:tokens && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "build:tokens": "style-dictionary build --config style-dictionary.config.js",
    "watch:tokens": "style-dictionary build --config style-dictionary.config.js --watch"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^9.74.4",
    "@react-three/xr": "^6.6.20",
    "@sentry/nextjs": "^10.1.0",
    "@stripe/stripe-js": "^7.8.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/animejs": "^3.1.7",
    "@types/howler": "^2.2.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.157.0",
    "animejs": "^3.2.1",
    "autoprefixer": "^10.0.1",
    "axios": "^1.6.0",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^10.18.0",
    "howler": "^2.2.4",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.1.0",
    "konva": "^9.2.0",
    "lucide-react": "^0.292.0",
    "next": "14.0.0",
    "postcss": "^8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-ga4": "^2.1.0",
    "react-hook-form": "^7.47.0",
    "react-hot-toast": "^2.4.1",
    "react-konva": "^18.2.10",
    "react-query": "^3.39.3",
    "react-three-fiber": "^6.0.13",
    "recharts": "^3.2.0",
    "socket.io-client": "^4.7.2",
    "sonner": "^2.0.7",
    "stripe": "^18.4.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.6",
    "three": "^0.160.0",
    "typescript": "^5",
    "valtio": "^1.8.0",
    "zod": "^3.25.76",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8",
    "eslint-config-next": "14.0.0",
    "jest": "^30.0.5",

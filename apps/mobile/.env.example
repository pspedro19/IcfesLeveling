# ICFES Leveling - Environment Configuration
# Copy this file to .env and configure your values
# IMPORTANT: Never commit .env to version control

# API Configuration
API_URL=http://localhost:4000/api/v1
# Production: https://api.icfesleveling.com/api/v1

# Sentry Configuration (Crash Reporting)
SENTRY_DSN=
# Get your DSN from https://sentry.io

# Environment Mode
ENV=development
# Options: development, staging, production

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
DEBUG_MODE=true

# Firebase (configured via google-services.json and GoogleService-Info.plist)
# No additional env vars needed for Firebase

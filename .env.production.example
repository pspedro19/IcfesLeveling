# ============================================
# ICFES Leveling - Production Environment
# ============================================
# Copy this file to .env and fill in all values
# All variables marked REQUIRED must be set before deploying

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_NAME=gameplay_db
DB_USER=gameplay
DB_PASSWORD=                    # REQUIRED: Strong password (min 20 chars, mixed case + numbers + symbols)
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ============================================
# REDIS
# ============================================
REDIS_PASSWORD=                 # REQUIRED: Strong password for Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ============================================
# CLICKHOUSE (Analytics)
# ============================================
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=            # REQUIRED: ClickHouse password
CLICKHOUSE_DATABASE=gameplay_analytics
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000

# ============================================
# SECURITY / AUTH
# ============================================
JWT_SECRET=                     # REQUIRED: Min 32 chars. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=                     # REQUIRED: Min 32 chars. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# APPLICATION
# ============================================
ENVIRONMENT=production
DEBUG=false
APP_VERSION=1.0.0
ALLOWED_ORIGINS=https://api.icfesleveling.com
ALLOWED_HOSTS=api.icfesleveling.com,localhost

# ============================================
# PAYMENTS - WOMPI (Colombia)
# ============================================
WOMPI_PUBLIC_KEY=               # REQUIRED for payments: Get from Wompi dashboard
WOMPI_PRIVATE_KEY=              # REQUIRED for payments: Get from Wompi dashboard
WOMPI_EVENT_SECRET=             # REQUIRED for payments: Webhook event signing secret
WOMPI_ENVIRONMENT=production    # "production" or "sandbox"

# ============================================
# AI SERVICES
# ============================================
ANTHROPIC_API_KEY=              # Optional: For Claude-powered study plans
OPENAI_API_KEY=                 # Optional: For AI explanations

# ============================================
# ERROR TRACKING
# ============================================
SENTRY_DSN=                     # Optional: Sentry DSN for error tracking

# ============================================
# FIREBASE (Push Notifications & Auth)
# ============================================
FIREBASE_PROJECT_ID=            # Optional: Firebase project ID
FIREBASE_CREDENTIALS_PATH=     # Option 1: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS_JSON=  # Option 2: Full service account JSON as string (for Docker/CI)

# ============================================
# DATA IMPORT (Startup)
# ============================================
AUTO_IMPORT_QUESTIONS=false     # Set true only on first deploy
IMPORT_CLEAR_EXISTING=false    # DANGER: Set true only if you want to wipe questions
QUESTIONS_EXCEL_PATH=/seed_data/questions.xlsx
ICFES_CATALOG_CSV_PATH=/seed_data/catalogs/icfes_topics.csv

# ============================================
# BACKUPS
# ============================================
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# ============================================
# DEPLOYMENT (GitHub Actions)
# ============================================
# These are set as GitHub Secrets, not in .env:
# DEPLOY_HOST=your-server-ip
# DEPLOY_USER=deploy
# DEPLOY_SSH_KEY=<private key>

# ============================================
# PGADMIN (Development only - do not use in production)
# ============================================
# PGADMIN_EMAIL=admin@icfes.com
# PGADMIN_PASSWORD=change-me
